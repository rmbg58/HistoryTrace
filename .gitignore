# 依赖与构建产物
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
.venv/

# web 数据产物(可由 `uv run ht build` 重建;claims 才是事实源)
web/public/data/*
# 例外:疆界快照由 49MB 受限缓存派生(CI 无法重建),且许可 CC-BY-4.0 可分发
!web/public/data/boundaries.json

# 数据管线:外部来源下载缓存(许可受限,永不入库:CHGIS/CBDB/dump 等)
data/_downloaded/

# 数据管线:派生缓存(可由 ht build 重建)
data/_cache/

# 环境与密钥
.env
.env.*
!.env.example

# 日志与系统
*.log
.DS_Store

# devinit 可选运行时目录
.devinit/runtime/
